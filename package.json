{
  "name": "aarogyam-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "start": "node server/index.js",
    "dev": "node scripts/dev.js",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "node scripts/build.js",
    "build:client": "npm run build --workspace client",
    "preview": "npm run preview --workspace client",
    "test": "npm run test --workspace client && npm run test --workspace server",
    "test:db": "npm run test:db --workspace client",
    "test:gemini": "npm run test:gemini --workspace server"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@supabase/supabase-js": "^2.119.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17"
  }
}
